
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Password Reset OTP</title>
</head>

<body
    style="
        margin: 0;
        padding: 0;
        background-color: #f4f7f6;
        font-family: Arial, Helvetica, sans-serif;
        color: #1f2937;
    "
>
    <table
        width="100%"
        cellpadding="0"
        cellspacing="0"
        border="0"
        style="background-color: #f4f7f6; padding: 40px 15px;"
    >
        <tr>
            <td align="center">

                <!-- Main Container -->
                <table
                    width="100%"
                    cellpadding="0"
                    cellspacing="0"
                    border="0"
                    style="
                        max-width: 600px;
                        background-color: #ffffff;
                        border-radius: 12px;
                        overflow: hidden;
                        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
                    "
                >

                    <!-- Header -->
                    <tr>
                        <td
                            align="center"
                            style="
                                background-color: #00633c;
                                padding: 28px 20px;
                            "
                        >
                            <h1
                                style="
                                    margin: 0;
                                    color: #ffffff;
                                    font-size: 28px;
                                    font-weight: 700;
                                "
                            >
                                DistrictFix
                            </h1>

                            <p
                                style="
                                    margin: 8px 0 0;
                                    color: #d9f5e8;
                                    font-size: 14px;
                                "
                            >
                                Reliable Home Service Platform
                            </p>
                        </td>
                    </tr>

                    <!-- Content -->
                    <tr>
                        <td style="padding: 40px 35px;">

                            <h2
                                style="
                                    margin: 0 0 15px;
                                    font-size: 24px;
                                    color: #111827;
                                "
                            >
                                Password Reset Request
                            </h2>

                            <p
                                style="
                                    margin: 0 0 15px;
                                    font-size: 15px;
                                    line-height: 1.7;
                                    color: #4b5563;
                                "
                            >
                                Hello <strong><%= name || "there" %></strong>,
                            </p>

                            <p
                                style="
                                    margin: 0 0 25px;
                                    font-size: 15px;
                                    line-height: 1.7;
                                    color: #4b5563;
                                "
                            >
                                We received a request to reset the password
                                associated with your DistrictFix account.
                                Use the verification code below to continue.
                            </p>

                            <!-- OTP Box -->
                            <table
                                width="100%"
                                cellpadding="0"
                                cellspacing="0"
                                border="0"
                            >
                                <tr>
                                    <td align="center">
                                        <div
                                            style="
                                                display: inline-block;
                                                background-color: #f0fdf7;
                                                border: 2px dashed #00633c;
                                                border-radius: 10px;
                                                padding: 18px 35px;
                                                margin: 5px 0 25px;
                                            "
                                        >
                                            <p
                                                style="
                                                    margin: 0 0 8px;
                                                    font-size: 12px;
                                                    color: #6b7280;
                                                    text-transform: uppercase;
                                                    letter-spacing: 2px;
                                                "
                                            >
                                                Verification Code
                                            </p>

                                            <h1
                                                style="
                                                    margin: 0;
                                                    font-size: 36px;
                                                    letter-spacing: 8px;
                                                    color: #00633c;
                                                "
                                            >
                                                <%= otp %>
                                            </h1>
                                        </div>
                                    </td>
                                </tr>
                            </table>

                            <p
                                style="
                                    margin: 0 0 10px;
                                    font-size: 14px;
                                    line-height: 1.6;
                                    color: #4b5563;
                                "
                            >
                                This OTP is valid for
                                <strong>5 minutes</strong>.
                            </p>

                            <p
                                style="
                                    margin: 0 0 25px;
                                    font-size: 14px;
                                    line-height: 1.6;
                                    color: #6b7280;
                                "
                            >
                                If you did not request a password reset,
                                please ignore this email. Your account
                                remains secure.
                            </p>

                            <!-- Security Notice -->
                            <div
                                style="
                                    background-color: #f9fafb;
                                    border-left: 4px solid #00633c;
                                    padding: 14px 16px;
                                    border-radius: 5px;
                                "
                            >
                                <p
                                    style="
                                        margin: 0;
                                        font-size: 13px;
                                        line-height: 1.6;
                                        color: #4b5563;
                                    "
                                >
                                    <strong>Security tip:</strong>
                                    Never share this OTP with anyone,
                                    including DistrictFix support.
                                </p>
                            </div>

                        </td>
                    </tr>

                    <!-- Footer -->
                    <tr>
                        <td
                            align="center"
                            style="
                                background-color: #f9fafb;
                                padding: 25px 20px;
                                border-top: 1px solid #e5e7eb;
                            "
                        >
                            <p
                                style="
                                    margin: 0 0 8px;
                                    font-size: 13px;
                                    color: #6b7280;
                                "
                            >
                                © <%= new Date().getFullYear() %> DistrictFix
                            </p>

                            <p
                                style="
                                    margin: 0;
                                    font-size: 12px;
                                    color: #9ca3af;
                                "
                            >
                                This is an automated email. Please do not
                                reply to this message.
                            </p>
                        </td>
                    </tr>

                </table>

            </td>
        </tr>
    </table>
</body>
</html>

