<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    />
    <title>Password Reset Successful</title>
</head>

<body
    style="
        margin: 0;
        padding: 0;
        background-color: #f4f7f6;
        font-family: Arial, Helvetica, sans-serif;
        color: #1f2937;
    "
>
    <table
        width="100%"
        cellpadding="0"
        cellspacing="0"
        border="0"
        style="
            background-color: #f4f7f6;
            padding: 40px 15px;
        "
    >
        <tr>
            <td align="center">

                <!-- Main Container -->
                <table
                    width="100%"
                    cellpadding="0"
                    cellspacing="0"
                    border="0"
                    style="
                        max-width: 600px;
                        background-color: #ffffff;
                        border-radius: 12px;
                        overflow: hidden;
                        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
                    "
                >

                    <!-- Header -->
                    <tr>
                        <td
                            align="center"
                            style="
                                background-color: #00633c;
                                padding: 30px 20px;
                            "
                        >
                            <h1
                                style="
                                    margin: 0;
                                    color: #ffffff;
                                    font-size: 28px;
                                    font-weight: 700;
                                "
                            >
                                DistrictFix
                            </h1>

                            <p
                                style="
                                    margin: 8px 0 0;
                                    color: #d9f5e8;
                                    font-size: 14px;
                                "
                            >
                                Your Local Problem-Solving Platform
                            </p>
                        </td>
                    </tr>

                    <!-- Content -->
                    <tr>
                        <td
                            align="center"
                            style="
                                padding: 45px 35px;
                            "
                        >

                            <!-- Success Icon -->
                            <div
                                style="
                                    width: 70px;
                                    height: 70px;
                                    line-height: 70px;
                                    margin: 0 auto 25px;
                                    border-radius: 50%;
                                    background-color: #e8f7f0;
                                    color: #00633c;
                                    font-size: 38px;
                                    font-weight: bold;
                                "
                            >
                                ✓
                            </div>

                            <h2
                                style="
                                    margin: 0 0 15px;
                                    font-size: 26px;
                                    color: #111827;
                                "
                            >
                                Password Reset Successful
                            </h2>

                            <p
                                style="
                                    margin: 0 0 10px;
                                    font-size: 15px;
                                    line-height: 1.7;
                                    color: #4b5563;
                                "
                            >
                                Hello
                                <strong>
                                    <%= name || "there" %>
                                </strong>,
                            </p>

                            <p
                                style="
                                    max-width: 450px;
                                    margin: 0 auto 25px;
                                    font-size: 15px;
                                    line-height: 1.7;
                                    color: #4b5563;
                                "
                            >
                                Your DistrictFix account password has been
                                successfully reset.
                            </p>

                            <!-- Success Message -->
                            <div
                                style="
                                    background-color: #f0fdf7;
                                    border: 1px solid #b7e4ce;
                                    border-radius: 8px;
                                    padding: 16px 20px;
                                    margin-bottom: 25px;
                                "
                            >
                                <p
                                    style="
                                        margin: 0;
                                        font-size: 14px;
                                        line-height: 1.6;
                                        color: #166534;
                                    "
                                >
                                    Your new password is now active.
                                    You can use it the next time you sign in.
                                </p>
                            </div>

                            <p
                                style="
                                    margin: 0;
                                    font-size: 13px;
                                    line-height: 1.6;
                                    color: #6b7280;
                                "
                            >
                                If you did not make this change, please contact
                                our support team immediately and secure your
                                account.
                            </p>

                        </td>
                    </tr>

                    <!-- Footer -->
                    <tr>
                        <td
                            align="center"
                            style="
                                background-color: #f9fafb;
                                padding: 25px 20px;
                                border-top: 1px solid #e5e7eb;
                            "
                        >
                            <p
                                style="
                                    margin: 0 0 8px;
                                    font-size: 13px;
                                    color: #6b7280;
                                "
                            >
                                © <%= new Date().getFullYear() %> DistrictFix
                            </p>

                            <p
                                style="
                                    margin: 0;
                                    font-size: 12px;
                                    color: #9ca3af;
                                "
                            >
                                This is an automated email. Please do not
                                reply to this message.
                            </p>
                        </td>
                    </tr>

                </table>

            </td>
        </tr>
    </table>
</body>
</html>