<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Welcome to DistrictFix</title>
</head>

<body
  style="
    margin: 0;
    padding: 0;
    background-color: #f4f7f6;
    font-family: Arial, Helvetica, sans-serif;
    color: #333333;
  "
>
  <table
    width="100%"
    cellpadding="0"
    cellspacing="0"
    border="0"
    style="padding: 40px 15px;"
  >
    <tr>
      <td align="center">

        <!-- Main Container -->
        <table
          width="100%"
          cellpadding="0"
          cellspacing="0"
          border="0"
          style="
            max-width: 600px;
            background-color: #ffffff;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
          "
        >

          <!-- Header -->
          <tr>
            <td
              style="
                background-color: #00633c;
                padding: 28px 30px;
                text-align: center;
              "
            >
              <h1
                style="
                  margin: 0;
                  color: #ffffff;
                  font-size: 28px;
                  font-weight: 700;
                "
              >
                DistrictFix
              </h1>

              <p
                style="
                  margin: 8px 0 0;
                  color: #d9f1e7;
                  font-size: 14px;
                "
              >
                Your Local Problem-Solving Platform
              </p>
            </td>
          </tr>

          <!-- Content -->
          <tr>
            <td style="padding: 40px 35px;">

              <h2
                style="
                  margin: 0 0 15px;
                  color: #00633c;
                  font-size: 24px;
                "
              >
                Welcome, <%= name %>! 
              </h2>

              <p
                style="
                  margin: 0 0 18px;
                  font-size: 16px;
                  line-height: 1.7;
                  color: #444444;
                "
              >
                Congratulations! Your DistrictFix account has been
                successfully created and your email address has been verified.
              </p>

              <p
                style="
                  margin: 0 0 25px;
                  font-size: 16px;
                  line-height: 1.7;
                  color: #444444;
                "
              >
                You are now ready to connect with your local community,
                report problems, and help make your district a better place.
              </p>

              <!-- Success Box -->
              <table
                width="100%"
                cellpadding="0"
                cellspacing="0"
                border="0"
                style="
                  background-color: #edf8f3;
                  border-left: 4px solid #00633c;
                  border-radius: 6px;
                  margin-bottom: 28px;
                "
              >
                <tr>
                  <td style="padding: 18px 20px;">
                    <p
                      style="
                        margin: 0;
                        color: #00633c;
                        font-size: 15px;
                        font-weight: 600;
                      "
                    >
                      ✓ Your account is now active and ready to use.
                    </p>
                  </td>
                </tr>
              </table>

              <p
                style="
                  margin: 0 0 10px;
                  font-size: 15px;
                  color: #555555;
                "
              >
                With DistrictFix, you can:
              </p>

              <ul
                style="
                  margin: 0 0 28px;
                  padding-left: 22px;
                  color: #555555;
                  font-size: 15px;
                  line-height: 1.8;
                "
              >
                <li>Report local problems and issues</li>
                <li>Track the status of your reports</li>
                <li>Explore issues reported by your community</li>
                <li>Help improve your local district</li>
              </ul>

              <p
                style="
                  margin: 0;
                  font-size: 15px;
                  line-height: 1.7;
                  color: #666666;
                "
              >
                Thank you for joining
                <strong style="color: #00633c;">DistrictFix</strong>.
                Together, we can identify local problems and work toward
                better communities.
              </p>

            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td
              style="
                background-color: #f7f9f8;
                padding: 25px 30px;
                text-align: center;
                border-top: 1px solid #e8ecea;
              "
            >

              <p
                style="
                  margin: 0 0 8px;
                  color: #00633c;
                  font-size: 15px;
                  font-weight: 600;
                "
              >
                DistrictFix
              </p>

              <p
                style="
                  margin: 0 0 8px;
                  color: #777777;
                  font-size: 13px;
                "
              >
                Your Local Problem-Solving Platform
              </p>

              <p
                style="
                  margin: 0;
                  color: #999999;
                  font-size: 12px;
                  line-height: 1.5;
                "
              >
                This is an automated email. Please do not reply to this
                message.
              </p>

            </td>
          </tr>

        </table>

      </td>
    </tr>
  </table>
</body>
</html>

