model Profile {
    id String @id @default(uuid())

    avatar  String?
    phone   String?
    bio     String?
    address String?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    userId    String   @unique
    user      User     @relation(fields: [userId], references: [id], onDelete: Cascade,onUpdate: Cascade)

    @@map("profiles")
}
