model ServiceRequest {
    id String @id @default(uuid())

    serviceType ServiceType

    serviceName String
    description String

    address String
    phone   String?

    status ServiceRequestStatus @default(PENDING)

    cancellationReason String?

    assignedAt  DateTime?
    startedAt   DateTime?
    acceptedAt  DateTime?
    rejectedAt  DateTime?
    completedAt DateTime?
    cancelledAt DateTime?

    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt
    deletedAt DateTime?

    customerId      String
    customer        User           @relation(fields: [customerId], references: [id], onDelete: Cascade, onUpdate: Cascade)
    districtId      String
    district        District       @relation(fields: [districtId], references: [id], onDelete: Cascade, onUpdate: Cascade)
    serviceHolderId String?
    serviceHolder   ServiceHolder? @relation(fields: [serviceHolderId], references: [id])
    workerId String?
    worker   Worker? @relation(fields: [workerId], references: [id])
    @@index([customerId])
    @@index([districtId])
    @@index([status])
    @@index([serviceType])
    @@index([createdAt])
    @@index([deletedAt])
    @@map("service_requests")
}
