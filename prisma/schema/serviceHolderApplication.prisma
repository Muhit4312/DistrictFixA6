model ServiceHolderApplication {
    id String @id @default(uuid())

    businessName String
    phone        String
    address      String
    description  String

    status ApplicationStatus @default(PENDING)

    rejectionReason String?

    reviewedById String?
    reviewedAt   DateTime?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    userId String
    user   User   @relation("ServiceHolderApplicationUser", fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

    districtId String
    district   District @relation(fields: [districtId], references: [id], onDelete: Cascade, onUpdate: Cascade)

    reviewer User? @relation("ServiceHolderApplicationReviewer", fields: [reviewedById], references: [id], onDelete: Cascade, onUpdate: Cascade)

    @@index([userId])
    @@index([districtId])
    @@index([status])
    @@index([reviewedById])
    @@map("service_holder_applications")
}
